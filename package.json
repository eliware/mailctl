{
    "name": "@eliware/mailctl",
    "version": "1.2.8",
    "description": "Non-interactive MariaDB and RabbitMQ mail CLI for humans and AI agents.",
    "keywords": [
        "mail",
        "email",
        "cli",
        "mariadb",
        "rabbitmq",
        "ai-agents"
    ],
    "type": "module",
    "private": false,
    "bin": {
        "mailctl": "mailctl.mjs"
    },
    "files": [
        "mailctl.mjs",
        "src",
        "migrations",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "test": "eliware-test",
        "test:gaps": "eliware-test",
        "test:integration": "MAILCTL_INTEGRATION=1 npx --node-options=\"--experimental-vm-modules --no-warnings\" jest tests/integration --runInBand",
        "lint": "eliware-test --lint",
        "audit": "npm audit --omit=dev --audit-level=moderate",
        "pack": "npm pack --dry-run",
        "pack:check": "npm run pack"
    },
    "engines": {
        "node": ">=26"
    },
    "devDependencies": {
        "@eliware/test": "^2.1.3"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/?(*.)+(spec|test).mjs"
        ]
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/eliware/mailctl.git"
    },
    "homepage": "https://github.com/eliware/mailctl#readme",
    "bugs": {
        "url": "https://github.com/eliware/mailctl/issues"
    },
    "license": "MIT",
    "dependencies": {
        "@eliware/common": "^1.1.8",
        "@eliware/mysql": "^1.1.6",
        "@eliware/rabbitmq": "^1.1.8",
        "@eliware/snowflake": "^1.1.5",
        "dotenv": "^17.4.2"
    }
}
