{
    "name": "@eliware/mailctl",
    "version": "2.0.0",
    "description": "Non-interactive mail service REST API CLI for humans and AI agents.",
    "keywords": [
        "mail",
        "email",
        "cli",
        "rest-api",
        "mail-service",
        "ai-agents"
    ],
    "type": "module",
    "private": false,
    "bin": {
        "mailctl": "mailctl.mjs"
    },
    "files": [
        "mailctl.mjs",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "test": "eliware-test",
        "lint": "eliware-test --lint",
        "audit": "npm audit --omit=dev --audit-level=moderate",
        "pack": "npm pack --dry-run",
        "pack:check": "npm run pack"
    },
    "engines": {
        "node": ">=26"
    },
    "devDependencies": {
        "@eliware/test": "^2.1.4"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/?(*.)+(spec|test).mjs"
        ]
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/eliware/mailctl.git"
    },
    "homepage": "https://github.com/eliware/mailctl#readme",
    "bugs": {
        "url": "https://github.com/eliware/mailctl/issues"
    },
    "license": "MIT",
    "dependencies": {
        "@eliware/common": "^2.0.0"
    }
}
