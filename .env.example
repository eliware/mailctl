# Direct MariaDB connection used by @eliware/mysql.
# Required. Credential-bearing URL; keep it in ~/.config/mailctl/.env.
# Format: mysql://USER:PASSWORD@HOST/DATABASE
MYSQL_URL=mysql://user:password@database.example.test/mail

# RabbitMQ connection used by send, retry, and cancel.
# Required for those commands; read-only commands do not need RabbitMQ.
# Format: amqp://USER:PASSWORD@HOST/VHOST
RABBITMQ_URL=amqp://user:password@rabbitmq.example.test/mail

# Shared attachment storage path.
# Required for attachment commands; must be readable/writable by the CLI user.
# Use an absolute path. Do not place credentials in this value.
MAIL_STORAGE_PATH=/var/lib/mail-service
